{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Recorded heritage grant funding grouped by inferred project type.",
  "data": {
    "url": "data/funding_by_heritage_type.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum.heritage_type === 'Other / needs review' ? 'Others' : datum.heritage_type",
      "as": "display_type"
    }
  ],
  "width": "container",
  "height": 380,
  "mark": {
    "type": "circle",
    "opacity": 0.85,
    "color": "#23483D",
    "stroke": "#FFFEFA",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "display_type",
      "type": "nominal",
      "title": "Conservation project type",
      "axis": {
        "labelAngle": -30,
        "labelLimit": 150
      }
    },
    "y": {
      "field": "funding",
      "type": "quantitative",
      "title": "Total recorded funding (AUD, including GST)",
      "axis": {
        "format": "$,.0f"
      }
    },
    "size": {
      "field": "project_count",
      "type": "quantitative",
      "title": "Number of funded records",
      "scale": {
        "range": [300, 4000]
      }
    },
    "tooltip": [
      {
        "field": "display_type",
        "type": "nominal",
        "title": "Conservation project type"
      },
      {
        "field": "funding",
        "type": "quantitative",
        "title": "Total recorded funding (AUD)",
        "format": "$,.2f"
      },
      {
        "field": "project_count",
        "type": "quantitative",
        "title": "Number of funded records"
      }
    ]
  },
  "config": {
    "background": "#FFFEFA",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E8E3D9",
      "labelColor": "#4F514A",
      "titleColor": "#23483D"
    }
  }
}
