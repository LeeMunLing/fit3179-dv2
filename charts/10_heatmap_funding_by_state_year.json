{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/funding_by_state_year.csv"
  },
  "mark": {
    "type": "rect",
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Grant year",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "state",
      "type": "ordinal",
      "title": "State / territory",
      "sort": ["WA", "NT", "SA", "QLD", "NSW", "ACT", "VIC", "TAS"]
    },
    "color": {
      "condition": {
        "test": "!isValid(datum.total_funding) || datum.total_funding == 0",
        "value": "#F0F5F1"
      },
      "field": "total_funding",
      "type": "quantitative",
      "title": "Total funding ($)",
      "scale": {
        "domain": [0, 3500000],
        "range": ["#B5D0C2", "#8CB6A6", "#5C967D", "#3F806A", "#23483D"]
      },
      "legend": {
        "format": "$,.0f"
      }
    },
    "opacity": {
      "condition": {
        "test": "datum.total_funding == 0",
        "value": 1
      },
      "value": 1
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "state",
        "type": "nominal",
        "title": "State / territory"
      },
      {
        "field": "total_funding",
        "type": "quantitative",
        "title": "Total funding",
        "format": "$,.0f"
      },
      {
        "field": "grant_count",
        "type": "quantitative",
        "title": "Number of grants"
      }
    ]
  },
  "config": {
    "background": "#FFFEFA",
    "view": {
      "stroke": null
    }
  }
}
